<mxfile host="app.diagrams.net" agent="codex">
  <diagram id="cs9711-linux-architecture" name="CS9711 Linux Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="11" value="&lt;b&gt;&lt;font size='5'&gt;CS9711 Fingerprint — Linux driver architecture (userspace-only)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font size='3'&gt;Fedora 44 · libusb → libfprint(own CS9711 driver) → fprintd → PAM login&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=14;align=center;" verticalAlign="middle" parent="1"><mxGeometry x="300" y="10" width="480" height="60" as="geometry"/></mxCell>
        <mxCell id="12" value="&lt;b&gt;CS9711 fingerprint reader — USB 2541:9711 (full speed)&lt;/b&gt;&lt;br&gt;bulk OUT EP 0x01 · bulk IN EP 0x81 · 64-byte max packet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#C2410C;fontSize=13;" verticalAlign="middle" parent="1"><mxGeometry x="420" y="600" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="13" value="&lt;b&gt;Linux USB core + udev rule (udev/99-cs9711.rules)&lt;/b&gt;&lt;br&gt;TAG+=uaccess · MODE=0660 · GROUP=wheel → non-root device access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E5E4;strokeColor=#57534E;fontSize=13;" verticalAlign="middle" parent="1"><mxGeometry x="420" y="480" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="14" value="&lt;b&gt;libusb-1.0 — userspace driver, exclusive claim on the sensor&lt;/b&gt;&lt;br&gt;no kernel module anywhere in the path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;" verticalAlign="middle" parent="1"><mxGeometry x="420" y="390" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="15" value="&lt;b&gt;tools/cs9711_libusb — capture / debug tool&lt;/b&gt;&lt;br&gt;INIT(1) · RESET(2) · SCAN(4)&lt;br&gt;8-byte frames: &lt;code&gt;EA cmd 00 00 00 cmd EA&lt;/code&gt;&lt;br&gt;SCAN → 8000 B + 24 B = 34×236 raw frame → out.pgm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;align=center;" verticalAlign="middle" parent="1"><mxGeometry x="110" y="240" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="16" value="&lt;b&gt;libfprint 1.94.100 — rebuilt from Fedora SRPM&lt;/b&gt;&lt;br&gt;own driver &lt;code&gt;driver/libfprint-cs9711&lt;/code&gt; wired in via meson&lt;br&gt;open → INIT/RESET SSM · AWAIT_FINGER_ON → SCAN SSM&lt;br&gt;image 34×236 → 68×118 (FPI_PRINT_SIGFM) · .so API == system .so" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=12;align=center;" verticalAlign="middle" parent="1"><mxGeometry x="690" y="240" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="17" value="&lt;b&gt;fprintd daemon (D-Bus)&lt;/b&gt;&lt;br&gt;enroll · verify · template storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" verticalAlign="middle" parent="1"><mxGeometry x="690" y="120" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="18" value="&lt;b&gt;Consumers — login &amp;amp; tooling&lt;/b&gt;&lt;br&gt;fprintd-enroll / fprintd-verify (CLI) · pam_fprintd → GDM greeter login + sudo (password fallback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontSize=13;align=center;" verticalAlign="middle" parent="1"><mxGeometry x="110" y="30" width="880" height="70" as="geometry"/></mxCell>
        <mxCell id="19" value="&lt;b&gt;Wire protocol (bulk)&lt;/b&gt;&lt;br&gt;cmd frame (8 B): &lt;code&gt;EA cmd 00 00 00 cmd EA&lt;/code&gt;&lt;br&gt;INIT/RESET reply magic: &lt;code&gt;EA 01 62 A0 00 00 C3 EA&lt;/code&gt;&lt;br&gt;SCAN: block1 8000 B + block2 24 B → 34×236 (8024 B)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#94A3B8;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" verticalAlign="middle" parent="1"><mxGeometry x="110" y="390" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="20" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;• userspace-only: no kernel module → no kernel ABI churn&lt;br&gt;• libusb tool and fprintd coexist (momentary claims)&lt;br&gt;• Phase 1 done: rebuilt libfprint drop-in (API identical)&lt;br&gt;• next: Phase 2 install .so + metainfo, enroll/verify" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#94A3B8;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" verticalAlign="middle" parent="1"><mxGeometry x="110" y="520" width="280" height="160" as="geometry"/></mxCell>
        <mxCell id="21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#404040;endArrow=block;endFill=1;exitDx=0;exitDy=0;" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#404040;endArrow=block;endFill=1;exitDx=0;exitDy=0;" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#404040;endArrow=block;endFill=1;exitDx=0;exitDy=0;exitX=0.2;exitY=0;entryX=0.85;entryY=1;" parent="1" source="14" target="15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#404040;endArrow=block;endFill=1;exitDx=0;exitDy=0;exitX=0.85;exitY=0;entryX=0.15;entryY=1;" parent="1" source="14" target="16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#404040;endArrow=block;endFill=1;exitDx=0;exitDy=0;" parent="1" source="16" target="17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#404040;endArrow=block;endFill=1;exitDx=0;exitDy=0;entryX=0.93;entryY=1;" parent="1" source="17" target="18"><mxGeometry relative="1" as="geometry"/></mxCell>
