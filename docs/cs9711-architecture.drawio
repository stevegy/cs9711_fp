        <mxCell id="14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;" value="&lt;b&gt;libusb-1.0 — userspace driver, exclusive claim on the sensor&lt;/b&gt;&lt;br&gt;no kernel module anywhere in the path" vertex="1" verticalAlign="middle">
