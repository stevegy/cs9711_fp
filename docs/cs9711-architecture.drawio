        <mxCell id="11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=14;align=center;" value="&lt;b&gt;&lt;font size=&#39;5&#39;&gt;CS9711 Fingerprint — Linux driver architecture (userspace-only)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font size=&#39;3&#39;&gt;Fedora 44 · libusb → libfprint(own CS9711 driver) → fprintd → PAM login&lt;/font&gt;" vertex="1" verticalAlign="middle">
          <mxGeometry height="60" width="840" x="150" y="-790" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#C2410C;fontSize=13;" value="&lt;b&gt;CS9711 fingerprint reader — USB 2541:9711 (full speed)&lt;/b&gt;&lt;br&gt;bulk OUT EP 0x01 · bulk IN EP 0x81 · 64-byte max packet" vertex="1" verticalAlign="middle">
          <mxGeometry height="80" width="400" x="480" y="-130" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E5E4;strokeColor=#57534E;fontSize=13;" value="&lt;b&gt;Linux USB core + udev rule (udev/99-cs9711.rules)&lt;/b&gt;&lt;br&gt;TAG+=uaccess · MODE=0660 · GROUP=wheel → non-root device access" vertex="1" verticalAlign="middle">
          <mxGeometry height="70" width="400" x="480" y="-225" as="geometry" />
