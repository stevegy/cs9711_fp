        <mxCell id="19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#94A3B8;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;Wire protocol (bulk)&lt;/b&gt;&lt;br&gt;cmd frame (8 B): &lt;code&gt;EA cmd 00 00 00 cmd EA&lt;/code&gt;&lt;br&gt;INIT/RESET reply magic: &lt;code&gt;EA 01 62 A0 00 00 C3 EA&lt;/code&gt;&lt;br&gt;SCAN: block1 8000 B + block2 24 B → 34×236 (8024 B)" vertex="1" verticalAlign="middle">
