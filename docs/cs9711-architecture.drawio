        </mxCell>
        <mxCell id="15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;align=center;" value="&lt;b&gt;tools/cs9711_libusb — capture / debug tool&lt;/b&gt;&lt;br&gt;INIT(1) · RESET(2) · SCAN(4)&lt;br&gt;8-byte frames: &lt;code&gt;EA cmd 00 00 00 cmd EA&lt;/code&gt;&lt;br&gt;SCAN → 8000 B + 24 B = 34×236 raw frame → out.pgm" vertex="1" verticalAlign="middle">
          <mxGeometry height="130" width="300" x="330" y="-500" as="geometry" />
        </mxCell>
        <mxCell id="16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=12;align=center;" value="&lt;b&gt;libfprint 1.94.100 — rebuilt from Fedora SRPM&lt;/b&gt;&lt;br&gt;own driver &lt;code&gt;driver/libfprint-cs9711&lt;/code&gt; wired in via meson&lt;br&gt;open → INIT/RESET SSM · AWAIT_FINGER_ON → SCAN SSM&lt;br&gt;image 34×236 → 68×118 (FPI_PRINT_SIGFM) · .so API == system .so" vertex="1" verticalAlign="middle">
          <mxGeometry height="130" width="300" x="720" y="-500" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" value="&lt;b&gt;fprintd daemon (D-Bus)&lt;/b&gt;&lt;br&gt;enroll · verify · template storage" vertex="1" verticalAlign="middle">
          <mxGeometry height="70" width="300" x="720" y="-600" as="geometry" />
