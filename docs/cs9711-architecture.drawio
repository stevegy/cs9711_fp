        <mxCell id="18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontSize=13;align=center;" value="&lt;b&gt;Consumers — login &amp; tooling&lt;/b&gt;&lt;br&gt;fprintd-enroll / fprintd-verify (CLI) · pam_fprintd → GDM greeter login + sudo (password fallback)" vertex="1" verticalAlign="middle">
          <mxGeometry height="70" width="300" x="720" y="-710" as="geometry" />
